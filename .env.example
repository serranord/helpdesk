APP_NAME="HelpDesk DR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Santo_Domingo

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Para MySQL descomenta:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=helpdesk_dr
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=480

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

# MCP web: token estático opcional. Vacío utiliza únicamente OAuth con Microsoft.
MCP_TOKEN=
# Orígenes de callback permitidos para registrar clientes OAuth (HTTPS).
MCP_REDIRECT_DOMAINS=*
# Orígenes web permitidos, separados por coma; vacío rechaza peticiones con Origin.
MCP_ALLOWED_ORIGINS=
